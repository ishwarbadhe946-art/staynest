# Copy to .env  (never commit the real .env)

# Port the server listens on (Render/Railway/Heroku set this automatically)
PORT=5000

# MongoDB connection string (MongoDB Atlas or local).
# Leave EMPTY to run with the in-memory demo store (data resets on restart).
MONGO_URI=mongodb+srv://staynest_admin:<db_password>@cluster0.ivxg4zo.mongodb.net/?appName=Cluster0
# Secret used to sign login tokens - set a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Set to "false" to skip inserting the 6 sample hostels into an empty database
SEED=true
